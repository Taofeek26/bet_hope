# =============================================================================
# BET_HOPE PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.prod and fill in your values
# NEVER commit .env.prod to git!

# Django Settings
DJANGO_SECRET_KEY=your-super-secret-key-generate-one-using-python
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost
DJANGO_ENV=production

# Database (handled by docker-compose, but can override)
# DATABASE_URL=postgres://bet_hope:password@db:5432/bet_hope
DB_PASSWORD=secure_password_change_me

# Redis / Celery (handled by docker-compose)
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db

# API Keys
# Football-Data.org (RECOMMENDED - free, 10 req/min)
# Get key at: https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_KEY=your-football-data-org-key

# API-Football (alternative - 100 req/day)
API_FOOTBALL_KEY=your-api-football-key

OPENAI_API_KEY=your-openai-api-key

# CORS - the frontend is deployed on Vercel, so list its exact URL(s) here.
# No trailing slash. Include both your production domain (once you have one)
# and Vercel's default *.vercel.app URL.
CORS_ALLOWED_ORIGINS=https://bet-hope.vercel.app,https://yourdomain.com

# Optional: regex patterns (comma-separated) to also allow Vercel's dynamic
# per-branch preview deployment URLs, e.g.:
# CORS_ALLOWED_ORIGIN_REGEXES=^https://bet-hope-.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

# Optional: extra CSRF-trusted origins beyond CORS_ALLOWED_ORIGINS (only
# needed for browser-session flows like Django admin from a cross-origin
# preview URL). Supports Django's "https://*.vercel.app" wildcard syntax.
CSRF_TRUSTED_ORIGINS_EXTRA=

# Feature Flags
ENABLE_DOCUMENT_AI=True
