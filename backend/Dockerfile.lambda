# Lambda-optimized Dockerfile — CPU-only, minimal deps, ~2GB
FROM python:3.11-slim

WORKDIR /app

# Runtime deps only (no build-essential, no git)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements (minimal — no GPU, no dev tools)
COPY requirements-lambda.txt .
RUN pip install --no-cache-dir -r requirements-lambda.txt \
    --extra-index-url https://download.pytorch.org/whl/cpu

# Copy application code (exclude tests, dev configs via .dockerignore)
COPY config/ ./config/
COPY apps/ ./apps/
COPY manage.py .
COPY lambda_handler.py .

# Lambda Web Adapter
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.8.4 /lambda-adapter /opt/extensions/lambda-adapter

# Create data directories
RUN mkdir -p /app/ml/artifacts /app/data/raw /app/logs

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV DJANGO_SETTINGS_MODULE=config.settings.lambda_settings
ENV DJANGO_ENV=production

EXPOSE 8080
CMD ["python", "lambda_handler.py"]